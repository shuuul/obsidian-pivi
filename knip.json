{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["src/main.ts", "scripts/*.{js,mjs}", "build/**/*.mjs"],
      "project": ["src/**/*.{ts,tsx}", "scripts/**/*.{js,mjs}", "build/**/*.mjs", "tests/**/*.{ts,tsx}"]
    },
    "packages/engine-pi": {
      "entry": ["src/shims/signalExit.cjs"],
      "project": ["src/**/*.{ts,tsx,cjs}"]
    },
    "packages/obsidian-host": {
      "entry": ["src/shims/debug.ts"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/*": {
      "project": ["src/**/*.{ts,tsx}"]
    }
  }
}
